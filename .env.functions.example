# ============================================================
# DESIGNE — Secrets das Edge Functions (Supabase)
# Configure em: Dashboard Supabase > Project Settings > Edge Functions > Secrets
# ============================================================

# --- IA (escolha 1 provedor) ---
AI_PROVIDER=lovable                # lovable | openai | anthropic | gemini | openrouter | custom
LOVABLE_API_KEY=                   # se AI_PROVIDER=lovable
OPENAI_API_KEY=                    # se AI_PROVIDER=openai
ANTHROPIC_API_KEY=                 # se AI_PROVIDER=anthropic
GEMINI_API_KEY=                    # se AI_PROVIDER=gemini
OPENROUTER_API_KEY=                # se AI_PROVIDER=openrouter
AI_BASE_URL=                       # se AI_PROVIDER=custom (endpoint compatível OpenAI)
AI_API_KEY=                        # se AI_PROVIDER=custom
AI_DEFAULT_MODEL=                  # opcional, ex: gpt-4o-mini, claude-3-5-sonnet-latest

# --- Scraping ---
FIRECRAWL_API_KEY=                 # https://firecrawl.dev

# --- TMDB (filmes/séries) ---
TMDB_API_KEY=                      # https://www.themoviedb.org/settings/api

# --- Mercado Livre (opcional, produtos afiliados) ---
ML_APP_ID=
ML_CLIENT_SECRET=

# --- Supabase (injetadas automaticamente no Supabase hospedado;
#     no self-host preencha manualmente) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
