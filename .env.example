# URL pública do seu projeto Supabase (auto-hospedado ou hospedado)
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Chave anon pública (segura para o frontend, NÃO use service_role aqui)
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."

# Project ref (apenas para sitemap/edge function URL — opcional)
VITE_SUPABASE_PROJECT_ID="seu-project-ref"
